# ════════════════════════════════════════════════
#  ReplyBot AI — Environment Variables v3.1
#  Copy to .env and fill in your values
# ════════════════════════════════════════════════

# ── Anthropic (REQUIRED) ─────────────────────────
# Get from: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ── Your Business Info ───────────────────────────
RB_PHONE=+15550000000
RB_EMAIL=hello@yourbusiness.com
RB_BOOKING=https://calendly.com/your-link
RB_WEBSITE=https://yourbusiness.com

# ── Slack (optional) ─────────────────────────────
# Get from: api.slack.com/apps → Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ── Airtable (optional) ──────────────────────────
# Token: airtable.com/create/tokens (scope: data.records:write)
# Base ID: from URL airtable.com/appXXXXXX/...
AIRTABLE_API_KEY=patXXXXXXXXXXXXXX
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_TABLE_NAME=Leads

# ── Twilio SMS (optional) ────────────────────────
# Get from: console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+15551234567   # Your Twilio number
TWILIO_ALERT_NUMBER=+15559876543  # Your personal mobile for alerts

# ── Supabase (optional — enables transcript storage + /api/stats) ──
# Get from: supabase.com → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── SendGrid Email (optional) ────────────────────
# Get from: app.sendgrid.com → Settings → API Keys
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=alerts@yourbusiness.com   # must be verified in SendGrid
SENDGRID_ALERT_EMAIL=you@yourbusiness.com     # where alerts are sent

# ── GoHighLevel CRM (optional) ───────────────────
# API v2: Settings → API Keys in your GHL account
# Location ID: Settings → Business Profile
GHL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GHL_LOCATION_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── HubSpot CRM (optional) ───────────────────────
# Settings → Integrations → Private Apps
# Scope needed: crm.objects.contacts.write
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Server ───────────────────────────────────────
PORT=3000
PORT=3000

# ── Admin Dashboard ──────────────────────────────────
# Password shown on /admin.html login screen — also used to protect /api/leads
ADMIN_PASSWORD=replybot2025
